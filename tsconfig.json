{
  "extends": "@micelio/tsconfig",
  "compilerOptions": {
    // Strapi loads the compiled server as CommonJS on an ES2019 target.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "target": "ES2019",
    "incremental": true,
    "noImplicitThis": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    // Include root files
    "./",
    // Include all ts files
    "./**/*.ts",
    // Include all js files
    "./**/*.js",
    // Force the JSON files in the src folder to be included
    "src/**/*.json"
  ],

  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    ".cache/",
    ".tmp/",
    ".strapi/",

    // Do not include admin files in the server compilation
    "src/admin/",
    // Do not include test files or test harness
    "tests/",
    "**/*.test.*",
    // Do not include tooling configs compiled separately
    "jest.config.js",
    "eslint.config.mjs",
    // Do not include plugins in the server compilation
    "src/plugins/**"
  ]
}
