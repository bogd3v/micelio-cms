HOST=0.0.0.0
PORT=1337
# Strapi secrets: run `npm run generate:keys`. In production the CMS refuses to
# start when one is empty, a placeholder or shorter than 32 characters.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (sqlite for dev and staging, postgres for production)
DATABASE_CLIENT=sqlite
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
# Required with DATABASE_CLIENT=postgres in production, and never `strapi`.
DATABASE_PASSWORD=
DATABASE_FILENAME=.tmp/data.db
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# UPLOAD_FROM_URL_ENABLED: the Media Library "From URL" import is off unless this is exactly true.
UPLOAD_FROM_URL_ENABLED=false

# Admin flags
# FLAG_NPS: the in-admin satisfaction survey sends answers to Strapi; off unless set to true.
# Strapi telemetry is off too (package.json, strapi.telemetryDisabled); see docs/operate/configure.md to turn it on.
FLAG_NPS=false
FLAG_PROMOTE_EE=true


# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket; also allowed in the admin's CSP so uploads show there
R2_BASE_URL=

# Email (accounts: confirmation and password reset). Without SMTP_HOST no email is
# delivered. EMAIL_FROM must be a sender your SMTP provider accepts, e.g.
# "My site <no-reply@example.com>"; unset, it is no-reply@ the frontend's host.
# See docs/ACCOUNTS.md
SMTP_HOST=
SMTP_PORT=587
# Refuse to send in clear when the server does not offer STARTTLS (port 465 is
# always encrypted). Only the value false turns it off, for a relay on a trusted network.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# The frontend's URL: links in emails, analytics paths, federated links and the
# site settings' URL. Required in production; defaults to http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Article URL on the frontend, for Umami paths and federated links
# FRONTEND_ARTICLE_PATH=/blog/{slug}
# FRONTEND_DEFAULT_LOCALE=en

# API tokens created on boot from these keys (32+ random characters each); unset,
# nothing is created. FRONTEND_API_TOKEN = the frontend's NUXT_STRAPI_API_TOKEN;
# BUILD_API_TOKEN = a read-only token for static builds. See docs/API_TOKENS.md
# FRONTEND_API_TOKEN=
# BUILD_API_TOKEN=

# Rebuild hook for static and landing sites: called (debounced) when articles,
# pages, the site settings, the About page or the categories are published, unpublished,
# deleted or saved. For GitHub,
# the repository_dispatch URL and a token that can trigger it. See docs/operate/configure.md
# In production a public http:// URL stops the boot (https, or http on a private network, is fine).
# Must be the final address: a redirect is refused and logged, not followed.
# REBUILD_HOOK_URL=
# REBUILD_HOOK_TOKEN=
# REBUILD_HOOK_DEBOUNCE_MS=60000

# Seeds a bilingual demo site once on an empty database (compose.demo.yml)
# MICELIO_DEMO=false

# Fediverse (ActivityPub). Off by default; see docs/FEDIVERSE.md and docs/operate/configure.md
FEDIVERSE_ENABLED=false
# Required when enabled, no defaults:
# FEDIVERSE_ACTOR_USERNAME=blog        # @user of the handle, safe to change
# FEDIVERSE_ACTOR_IDENTIFIER=blog      # actor URI path, never change it once federated
# FEDIVERSE_ACTOR_NAME=                # fallbacks when Global and the site settings are empty
# FEDIVERSE_ACTOR_SUMMARY=
# FEDIVERSE_ACTOR_SOURCE_URL=

# Rate limiting (docs/RATE_LIMITING.md). On by default (off under NODE_ENV=test);
# RATE_LIMIT_ENABLED=false restores the old behaviour. Limits are points/seconds,
# 0 turns a group off. With it on, the users-permissions limiter is replaced.
# RATE_LIMIT_ENABLED=true
# (TRUST_PROXY and PROXY_IP_HEADER apply even when this is false)
# memory (default, per process) or database (Postgres, shared by several instances)
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_AUTH=10/60               # /api/auth/*, /api/connect/*, DELETE /api/users/me
# RATE_LIMIT_AUTH_IDENTIFIER=10/900   # POST /api/auth/local, per login identifier
# RATE_LIMIT_ADMIN_AUTH=20/300        # POST /admin/login, forgot/reset-password, register-admin
# RATE_LIMIT_ADMIN_IDENTIFIER=10/900  # POST /admin/login, per admin email
# RATE_LIMIT_AUTH_EMAIL=5/3600        # emails sent per address (forgot-password, confirmation, register)
# RATE_LIMIT_COMMENTS=10/600          # non-GET /api/comments/*
# RATE_LIMIT_UPLOAD=30/600            # non-GET /api/upload
# RATE_LIMIT_FEDIVERSE_INBOX=60/60    # per client (IPv6 by /64)
# RATE_LIMIT_API=600/60               # the rest of /api/* and federation GETs, per client
# RATE_LIMIT_TOKEN=6000/60            # per content API token once a client is over its own limit; 0 = valid tokens unlimited
# Who the client is: private (default: read the proxy header only while the
# connection comes from a loopback or private address), a number of proxy hops
# (1 behind a single proxy), a comma separated list of proxy CIDR ranges, or false
# (use the socket address). "true" is refused.
# TRUST_PROXY=private
# Header your proxy sets with the client address; set it only if the proxy overwrites it
# PROXY_IP_HEADER=X-Forwarded-For
# false stops ctx.protocol and ctx.host from following X-Forwarded-Proto and -Host.
# With true they are followed only when the connection comes from a peer TRUST_PROXY trusts
# TRUST_PROXY_PROTOCOL=true
# Lets the frontend send X-Micelio-Client-IP with X-Micelio-Forwarder-Secret, so its
# users are limited one by one. 32+ random characters, the same value on both sides
# RATE_LIMIT_FORWARDER_SECRET=

# Disables every cron task (e.g. the Umami sync)
# STRAPI_DISABLE_CRON=false

# Days before an unconfirmed reader account or newsletter subscription is deleted by a
# daily job (needs cron enabled). Whole number from 0 to 36500; 0 turns the purge off. Deletion is permanent.
# UNCONFIRMED_RETENTION_DAYS=30

# Umami analytics (optional). Internal URL, website id and the API key of a View only
# user; the most read articles endpoint stays empty without them. See docs/ANALYTICS.md
# In production a public http:// URL stops the boot (https, or http on a private network, is fine).
# Must be the final address: a redirect is refused and logged, not followed.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
# UMAMI_SYNC_CRON=0 * * * *
# UMAMI_PUBLIC_URL=https://analytics.example.com

# Browser origins allowed by CORS, comma separated. Unset allows only the
# origin of FRONTEND_URL; * allows any origin, without credentials.
# See docs/operate/configure.md
# CORS_ORIGINS=https://example.com

# Relation levels a content API `populate`, `filters` or `sort` may nest; deeper requests get a 400.
# The Micelio frontend needs 3. See docs/operate/configure.md
# POPULATE_MAX_DEPTH=3

# Strapi MCP Server (requires Strapi 5.47.0+): /mcp is on unless
# STRAPI_MCP_ENABLED=false (config/server.ts). Clients authenticate with a Strapi
# Admin API token (Admin panel -> Settings -> Admin API Tokens). The MCP entry in
# .mcp.json reads the token from ~/.claude/secrets/strapi-mcp-admin-token

# Strapi's remote data transfer (`strapi transfer` from another instance, with an
# admin-created transfer token): off unless this is true. Local export and import
# are not affected. See docs/operate/configure.md
# STRAPI_REMOTE_TRANSFER_ENABLED=false

# Words no reader password may contain, comma separated, 4 or more characters each
# (the site and organisation names; a name with spaces is also banned without them). `micelio` and `strapi` are always banned.
# See docs/security/authentication.md
# PASSWORD_BANNED_WORDS=

# Docker volumes (named volumes for persistent storage)
# Volume names: <COMPOSE_PROJECT>_strapi-tmp, <COMPOSE_PROJECT>_strapi-db-data
COMPOSE_PROJECT=micelio-cms

# Backup / restore
BACKUP_DIR=/backups/micelio-cms
RETENTION_DAYS=14
