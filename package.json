{
  "name": "micelio-cms",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "build:fediverse": "esbuild src/plugins/fediverse/server/src/index.ts --bundle --packages=external --platform=node --format=cjs --outfile=src/plugins/fediverse/dist/strapi-server.js",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "generate:keys": "node ./scripts/generate-keys.js",
    "seed:example": "node ./scripts/seed.js",
    "prestart": "node -e \"require('fs').mkdirSync('public/uploads', { recursive: true })\"",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run lint:licenses && npm run lint:standard",
    "typecheck": "tsc --noEmit && tsc --project src/plugins/fediverse/tsconfig.json && tsc --project src/admin/tsconfig.json && tsc --project tests/tsconfig.json",
    "prebuild": "npm run build:fediverse",
    "predev": "npm run build:fediverse",
    "predevelop": "npm run build:fediverse",
    "pretest": "npm run build:fediverse",
    "lint": "eslint . && npm run lint:placement && npm run lint:ee",
    "lint:placement": "node scripts/check-placement.mjs",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:ee": "node scripts/check-no-ee.mjs",
    "lint:standard": "micelio-lint-standard",
    "lint:fix": "eslint . --fix",
    "docs:response-fields": "UPDATE_RESPONSE_FIELDS_DOC=1 jest tests/response-fields-docs.test.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "jest --forceExit",
    "test:handles": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:upgrade": "node scripts/upgrade-check/index.mjs"
  },
  "dependencies": {
    "@fedify/fedify": "2.4.4",
    "@fedify/koa": "2.4.4",
    "@fedify/postgres": "2.4.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@logtape/logtape": "^2.4.1",
    "@micelio/strapi-plugin-core": "0.2.0",
    "@notum-cz/strapi-plugin-seo": "^2.0.12",
    "@strapi/i18n": "^5.59.0",
    "@strapi/plugin-users-permissions": "^5.59.0",
    "@strapi/provider-email-nodemailer": "^5.59.0",
    "@strapi/provider-upload-aws-s3": "^5.59.0",
    "@strapi/strapi": "^5.60.0",
    "knex": "3.3.0",
    "pg": "^8.23.1",
    "postgres": "3.4.9",
    "rate-limiter-flexible": "11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "sanitize-html": "^2.17.5",
    "strapi-plugin-comments": "^3.2.4",
    "structured-field-values": "2.0.4",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@micelio/eslint-config": "^0.2.0",
    "@micelio/prettier-config": "^0.1.0",
    "@micelio/tsconfig": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "12.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.19.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "telemetryDisabled": true,
    "uuid": "c8f9eb3b-3208-4a3d-b35a-944b4dde5743",
    "installId": "964b072232ae06acbf76e84e14c792edb72cb22d44ea04c713df924ad2c47907"
  },
  "overrides": {
    "axios": "^1.20.0",
    "nodemailer": "^10.0.14",
    "sharp": "^0.35.5",
    "postcss": "^8.5.28",
    "markdown-it": "^14.3.2",
    "dompurify": "^3.4.17",
    "@opentelemetry/core": "^2.8.0",
    "handlebars": "^4.7.10",
    "react-intl": "^6.8.9"
  },
  "prettier": "@micelio/prettier-config"
}
