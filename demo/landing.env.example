# Settings for compose.landing.yml, used with --env-file:
#   docker compose --env-file demo/landing.env.example -f compose.landing.yml up
# Tokens never go here: the secrets are generated into the demo-secrets volume.

# Defaults: the X.Y of this release. Set a local build or an exact X.Y.Z.
MICELIO_CMS_IMAGE=ghcr.io/bogd3v/micelio-cms:0.4
MICELIO_BUILDER_IMAGE=ghcr.io/bogd3v/micelio-builder:0.4

# Form endpoint of your newsletter provider (https only). The newsletter is off
# when empty.
NUXT_PUBLIC_NEWSLETTER_FORM_ACTION=
