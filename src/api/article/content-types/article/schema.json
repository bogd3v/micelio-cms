{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Create your blog content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "regex": "^(?!\\.{1,2}$)[A-Za-z0-9-_.~]*$",
      "targetField": "title"
    },
    "cover": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos"]
    },
    "coverCredit": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-credit",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::micelio.category",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::micelio.tag",
      "inversedBy": "articles"
    },
    "blocks": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "shared.media",
        "shared.playground",
        "shared.quote",
        "shared.rich-text",
        "shared.slider"
      ]
    },
    "references": {
      "type": "component",
      "repeatable": true,
      "component": "shared.reference",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "translationCredits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.translation-credit",
      "max": 10,
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "plainText": {
      "type": "text",
      "private": true,
      "configurable": false,
      "visible": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "pathOrder": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  },
  "config": {
    "metadatas": {
      "pathOrder": {
        "edit": {
          "label": "pathOrder",
          "description": "Posición del artículo en la ruta de lectura de su categoría (1 = primero). Déjalo vacío para que no aparezca en la ruta. Se comparte entre idiomas."
        }
      },
      "references": {
        "edit": {
          "label": "references",
          "description": "Fuentes del artículo. Cítalas en el texto con [@clave] (varias: [@a; @b]); el número [n] sale del orden en que aparecen. Se comparten entre idiomas."
        }
      },
      "translationCredits": {
        "edit": {
          "label": "translationCredits",
          "description": "Quién tradujo este idioma: el id de actor ActivityPub de cada traductor (https://…), no la página de su perfil. Se publica en el fediverso con el artículo. Una traducción automática sin revisar acredita al actor del software, no a una persona sola. Propio de cada idioma."
        }
      }
    }
  }
}
