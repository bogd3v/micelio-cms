{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site settings",
    "description": "Identity of the site and the modules the frontend turns on"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "regex": "^https?://\\S+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultLocale": {
      "type": "enumeration",
      "enum": ["en", "es"],
      "default": "en",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "author": {
      "type": "component",
      "repeatable": false,
      "component": "site.author",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "site.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "contactEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "privacyContactEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "securityContact": {
      "type": "string",
      "maxLength": 512,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "privacyUpdatedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "supportHandle": {
      "type": "string",
      "regex": "^[A-Za-z0-9_-]+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "timezone": {
      "type": "string",
      "regex": "^[A-Za-z][A-Za-z0-9]*(?:[/_+-][A-Za-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "addressLocality": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "modules": {
      "type": "component",
      "repeatable": false,
      "component": "site.modules",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "site.theme",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "homePage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
