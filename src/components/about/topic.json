{
  "collectionName": "components_about_topics",
  "info": {
    "displayName": "Topic",
    "icon": "layer",
    "description": "A blog topic with its own description; category is the slug of a category of the site"
  },
  "options": {},
  "attributes": {
    "category": {
      "type": "string",
      "regex": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 64,
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    }
  }
}
