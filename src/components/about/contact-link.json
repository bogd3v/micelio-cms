{
  "collectionName": "components_about_contact_links",
  "info": {
    "displayName": "Contact link",
    "icon": "message",
    "description": "A social profile shown in the contact list"
  },
  "options": {},
  "attributes": {
    "network": {
      "type": "string",
      "required": true
    },
    "handle": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "regex": "^[hH][tT][tT][pP][sS]?://[^\\s\\u0000-\\u001f\\u007f]+$",
      "required": true
    }
  }
}
