{
  "collectionName": "components_section_post_lists",
  "info": {
    "displayName": "Post list",
    "icon": "bulletList",
    "description": "Latest articles, of a category or a tag"
  },
  "options": {},
  "attributes": {
    "blockId": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "anchor": {
      "type": "string"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["cards", "list", "featured"],
      "default": "cards",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::micelio.category"
    },
    "tag": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::micelio.tag"
    },
    "count": {
      "type": "integer",
      "min": 1,
      "max": 12,
      "default": 3,
      "required": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "enumeration",
      "enum": ["newest", "oldest", "alphabetical"],
      "default": "newest"
    },
    "tone": {
      "type": "enumeration",
      "enum": ["default", "raised", "accent"],
      "default": "default"
    },
    "align": {
      "type": "enumeration",
      "enum": ["start", "center"],
      "default": "start"
    }
  }
}
